# ── Supabase ──────────────────────────────────────────────────────────────────
# From: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# Server-side only (Vercel API routes) — never expose to browser
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ── Clerk ─────────────────────────────────────────────────────────────────────
# From: Clerk Dashboard → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# ── PostHog ───────────────────────────────────────────────────────────────────
# From: PostHog → Project Settings
VITE_POSTHOG_KEY=phc_...
VITE_POSTHOG_HOST=https://app.posthog.com

# ── Sentry ────────────────────────────────────────────────────────────────────
# From: Sentry → Project → Settings → Client Keys (DSN)
VITE_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/xxx
# Optional — enables source map upload during build
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-org
SENTRY_PROJECT=ventas

# ── Upstash Redis ─────────────────────────────────────────────────────────────
# From: Upstash Console → Database → REST API
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...

# ── Pinecone ──────────────────────────────────────────────────────────────────
# From: Pinecone Console → API Keys
PINECONE_API_KEY=pcsk_...
# Name of your Pinecone index (create with multilingual-e5-large model)
PINECONE_INDEX_NAME=ventas-products

# ── Vercel Cron ───────────────────────────────────────────────────────────────
# Random secret to authorize cron endpoints. Generate: openssl rand -hex 32
CRON_SECRET=change_me_to_random_hex

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to "true" to enable Pinecone semantic search (requires index to be populated)
VITE_ENABLE_PINECONE=false
