# Copia este archivo a `.env.local` y rellena los valores.
# `.env.local` está en .gitignore y nunca debe subirse: las dos últimas
# variables son llaves de servidor con permiso total sobre la base.

# ── Las que sí llegan al navegador (prefijo VITE_) ──────────────────────────
# Panel de Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Panel de Clerk → API Keys. Hoy en producción corre una instancia de
# desarrollo (pk_test_…), que es deuda pendiente.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Firma las consultas a Supabase con el token de Clerk. RLS ya está activo
# (ver supabase/RLS.md), así que esto debe quedar en true.
VITE_SUPABASE_CLERK_AUTH=true

# ── Solo servidor. NO llevan prefijo VITE_ a propósito ──────────────────────
# Si les pones VITE_ acaban en el paquete público, que es regalar la base.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CLERK_SECRET_KEY=

# Token del feed .ics de /api/calendario/feed (Personal → Calendario). Genera
# uno random y no lo compartas fuera de la URL de suscripción.
CALENDAR_FEED_TOKEN=
