PORT=3001

# Para activar WhatsApp Bot
WHATSAPP_ENABLED=false

# Clave secreta para JWT (generar con: openssl rand -hex 48)
JWT_SECRET=cambia_esto_por_una_clave_secreta_larga

# Hashes bcrypt de las contrasenas
# Para generar: node -e "require('bcryptjs').hash('TU_CONTRASENA', 12).then(console.log)"
ADMIN_HASH=
EDITOR1_HASH=
EDITOR2_HASH=

# Orígenes permitidos para CORS (tu dominio Vercel, separados por coma si hay varios)
# Ejemplo: https://ventas.vercel.app,https://zhinoism.online
CORS_ORIGIN=

# Directorio donde se guarda la base de datos SQLite
# En Railway, apuntar al volumen persistente: /data
# (por defecto usa ./data relativo al backend/)
DATA_DIR=
